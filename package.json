{
  "name": "3d-editor",
  "productName": "3D Editor",
  "version": "1.0.0",
  "description": "Настольный 3D-редактор сцены на Three.js",
  "main": "main.js",
  "author": "david",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "three": "0.168.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.david.3deditor",
    "productName": "3D Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "node_modules/three/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.graphics-design"
    }
  }
}
